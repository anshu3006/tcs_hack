# Copy this file to .env and fill in real values. Never commit the real .env.

# Primary provider
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backup provider (OpenAI-compatible, via OpenRouter - also lets you point at
# a plain OpenAI model by changing OPENROUTER_MODEL/URL if you'd rather)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Which provider the CLI uses by default (gemini | openrouter | mock)
DOC_WRITER_PROVIDER=gemini

# Where cached LLM responses are stored
DOC_WRITER_CACHE_DIR=.cache
